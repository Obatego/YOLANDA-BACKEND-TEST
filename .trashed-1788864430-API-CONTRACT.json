{
  "version": "1.0",
  "prototypeStorage": "localStorage",
  "endpoints": {
    "POST /api/auth/login": "Employee authentication",
    "GET /api/employees/me": "Employee profile",
    "PUT /api/employees/me": "Update employee profile",
    "POST /api/reports": "Submit daily/weekly report",
    "GET /api/reports": "List reports with filters",
    "GET /api/analytics/weekly": "Weekly KPI/trend data",
    "POST /api/files": "Upload report attachments"
  },
  "reportFields": [
    "date",
    "shift",
    "leads",
    "totalCalled",
    "spokenTo",
    "income",
    "notReached",
    "busy",
    "switchedOff",
    "wrongNumber",
    "duplicates",
    "smsSent",
    "summary",
    "attachment"
  ]
}